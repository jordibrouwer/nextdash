# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Node dev dependencies (Playwright debug scripts)
node_modules/
test-results/
playwright-report/
.playwright-extension-profile/

# Local / runtime data
data/
!static/data/
!static/data/**
.claude/
.DS_Store
nextDash
main
scripts/debug-config-save.mjs
nextDash.code-workspace

.vscode/settings.json
.idea/
.superpowers/

# Design working files: the design system, the repo analysis the design tool
# writes, its canvas/draft ids and its scratch HTML. Local working material,
# not part of the app — never committed and so never pushed.
.superdesign/

# Working notes: plans and specs stay on disk and out of the repository.
# They are for whoever is doing the work, not for anyone cloning it.
docs/

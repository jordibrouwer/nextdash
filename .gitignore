# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# env file
.env

# Node dev dependencies (Playwright debug scripts)
node_modules/
test-results/
playwright-report/
.playwright-extension-profile/

# Local / runtime data
data/
!static/data/
!static/data/**
.claude/
.DS_Store
nextDash
main
scripts/debug-config-save.mjs
nextDash.code-workspace

# Working notes -- design specs, implementation plans, anything written while
# building. They are for whoever wrote them, not for whoever clones the
# repository, so nothing under docs/ is committed. The two files below predate
# this rule and are already public; they stay tracked until removed on purpose.
docs/
!docs/dashboard-refactor.md
!docs/dashboard-smoke-checklist.md

{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": { "contentSize": "720px", "wideSize": "1040px" },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "bg", "name": "Background", "color": "var(--nd-bg)" },
        { "slug": "surface", "name": "Surface", "color": "var(--nd-surface)" },
        { "slug": "fg", "name": "Text", "color": "var(--nd-fg)" },
        { "slug": "muted", "name": "Muted", "color": "var(--nd-muted)" },
        { "slug": "line", "name": "Line", "color": "var(--nd-line)" },
        { "slug": "accent", "name": "Accent", "color": "var(--nd-accent)" },
        { "slug": "accent-soft", "name": "Accent, soft", "color": "var(--nd-accent-soft)" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        { "slug": "body", "name": "Source Sans 3", "fontFamily": "\"Source Sans 3\", system-ui, -apple-system, \"Segoe UI\", sans-serif" },
        { "slug": "mono", "name": "Source Code Pro", "fontFamily": "\"Source Code Pro\", ui-monospace, \"SF Mono\", Menlo, monospace" }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "14px" },
        { "slug": "normal", "name": "Normal", "size": "17px" },
        { "slug": "large", "name": "Large", "size": "20px" },
        { "slug": "x-large", "name": "Extra large", "size": "26px" }
      ]
    },
    "spacing": { "units": ["px", "em", "rem", "%"] }
  },
  "styles": {
    "color": { "background": "var(--nd-bg)", "text": "var(--nd-fg)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "17px", "lineHeight": "1.65" },
    "elements": {
      "link": { "color": { "text": "var(--nd-accent)" } },
      "heading": { "typography": { "fontWeight": "600", "lineHeight": "1.25" } },
      "code": { "typography": { "fontFamily": "var(--wp--preset--font-family--mono)" } }
    }
  }
}

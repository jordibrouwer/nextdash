[
  { "name": "upper selection", "command": "upper", "state": { "value": "one two", "start": 0, "end": 3 },
    "expect": { "value": "ONE two", "start": 0, "end": 3 } },
  { "name": "upper current line", "command": "upper", "state": { "value": "a\nbc\nd", "start": 3, "end": 3 },
    "expect": { "value": "a\nBC\nd", "start": 4, "end": 4 } },
  { "name": "upper on an empty first line", "command": "upper", "state": { "value": "\nab", "start": 0, "end": 0 },
    "expect": { "value": "\nab", "start": 0, "end": 0 } },
  { "name": "lower", "command": "lower", "state": { "value": "HeLLo", "start": 0, "end": 5 },
    "expect": { "value": "hello", "start": 0, "end": 5 } },
  { "name": "title", "command": "title", "state": { "value": "hELLO wORLD", "start": 0, "end": 11 },
    "expect": { "value": "Hello World", "start": 0, "end": 11 } },
  { "name": "todo prefixes every selected line", "command": "todo", "state": { "value": "x\ny", "start": 0, "end": 3 },
    "expect": { "value": "[ ] x\n[ ] y", "start": 11, "end": 11 } },
  { "name": "h1 on an empty note", "command": "h1", "state": { "value": "", "start": 0, "end": 0 },
    "expect": { "value": "# ", "start": 2, "end": 2 } },
  { "name": "bullet", "command": "bullet", "state": { "value": "x", "start": 0, "end": 0 },
    "expect": { "value": "- x", "start": 3, "end": 3 } },
  { "name": "quote", "command": "quote", "state": { "value": "x", "start": 0, "end": 0 },
    "expect": { "value": "> x", "start": 3, "end": 3 } },
  { "name": "code puts the caret on the blank line", "command": "code", "state": { "value": "ab", "start": 1, "end": 1 },
    "expect": { "value": "a```\n\n```b", "start": 5, "end": 5 } },
  { "name": "table", "command": "table", "state": { "value": "", "start": 0, "end": 0 },
    "expect": { "value": "| Column | Column |\n| --- | --- |\n|  |  |\n", "start": 42, "end": 42 } },
  { "name": "bold wraps the selection", "command": "bold", "state": { "value": "say hi", "start": 4, "end": 6 },
    "expect": { "value": "say **hi**", "start": 8, "end": 8 } },
  { "name": "bold with nothing selected", "command": "bold", "state": { "value": "", "start": 0, "end": 0 },
    "expect": { "value": "****", "start": 2, "end": 2 } },
  { "name": "italic", "command": "italic", "state": { "value": "a", "start": 0, "end": 1 },
    "expect": { "value": "*a*", "start": 2, "end": 2 } },
  { "name": "inline code", "command": "inlinecode", "state": { "value": "a", "start": 0, "end": 1 },
    "expect": { "value": "`a`", "start": 2, "end": 2 } },
  { "name": "link", "command": "link", "state": { "value": "go", "start": 0, "end": 2 },
    "expect": { "value": "[go](https://)", "start": 3, "end": 3 } },
  { "name": "h1 would exceed the limit", "command": "h1", "max": 3, "state": { "value": "abc", "start": 0, "end": 0 },
    "expect": null },
  { "name": "table would exceed the limit", "command": "table", "max": 10, "state": { "value": "", "start": 0, "end": 0 },
    "expect": null },
  { "name": "offsets are UTF-16 units", "command": "upper", "state": { "value": "😀x", "start": 2, "end": 3 },
    "expect": { "value": "😀X", "start": 2, "end": 3 } }
]

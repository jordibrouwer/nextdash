[
  {"name":"manual link wins",
   "container":{"name":"sonarr","ports":[8989]},
   "bookmarks":[{"name":"Sonarr","url":"http://nas.lan:8989","pageId":1},{"name":"TV","url":"https://tv.example.com","pageId":1}],
   "links":{"sonarr":"1::https://tv.example.com"},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::https://tv.example.com","via":"manual"}},
  {"name":"manual dash means none",
   "container":{"name":"sonarr","ports":[8989]},
   "bookmarks":[{"name":"Sonarr","url":"http://nas.lan:8989","pageId":1}],
   "links":{"sonarr":"-"},
   "hosts":["nas.lan","nextdash.local"],
   "want":null},
  {"name":"manual pointing at a missing bookmark falls through to the port",
   "container":{"name":"sonarr","ports":[8989]},
   "bookmarks":[{"name":"Shows","url":"http://nas.lan:8989","pageId":2}],
   "links":{"sonarr":"1::https://gone.example.com"},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"2::http://nas.lan:8989","via":"port"}},
  {"name":"port on this host",
   "container":{"name":"radarr","ports":[7878]},
   "bookmarks":[{"name":"Films","url":"http://nas.lan:7878/","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::http://nas.lan:7878/","via":"port"}},
  {"name":"port on the seen host and on localhost",
   "container":{"name":"radarr","ports":[7878]},
   "bookmarks":[{"name":"Films","url":"http://localhost:7878","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::http://localhost:7878","via":"port"}},
  {"name":"port on another host is no match",
   "container":{"name":"radarr","ports":[7878]},
   "bookmarks":[{"name":"Films","url":"http://other.lan:7878","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":null},
  {"name":"subdomain named after the container",
   "container":{"name":"grafana","ports":[]},
   "bookmarks":[{"name":"Dashboards","url":"https://grafana.home.example.com","pageId":1},{"name":"Other","url":"https://wiki.home.example.com","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::https://grafana.home.example.com","via":"subdomain"}},
  {"name":"title with loose naming",
   "container":{"name":"sonarr_4k","ports":[]},
   "bookmarks":[{"name":"Sonarr-4K","url":"https://x.example.org/tv","pageId":3}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"3::https://x.example.org/tv","via":"title"}},
  {"name":"two hits at one step give no match",
   "container":{"name":"radarr","ports":[7878]},
   "bookmarks":[{"name":"Films","url":"http://nas.lan:7878","pageId":1},{"name":"Films 2","url":"http://nextdash.local:7878","pageId":1},{"name":"Radarr","url":"https://radarr.example.com","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":null},
  {"name":"one address on two pages counts as one",
   "container":{"name":"radarr","ports":[7878]},
   "bookmarks":[{"name":"Films","url":"http://nas.lan:7878","pageId":1},{"name":"Films again","url":"http://nas.lan:7878","pageId":2}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::http://nas.lan:7878","via":"port"}},
  {"name":"webui host and port",
   "container":{"name":"proxy","webui":"https://admin.lan:8443/ui","ports":[]},
   "bookmarks":[{"name":"Admin","url":"https://admin.lan:8443","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::https://admin.lan:8443","via":"port"}},
  {"name":"webui with [IP] and the container's own LAN address",
   "container":{"name":"pihole","webui":"http://[IP]:8081/admin","lanIP":"192.168.1.50","ports":[]},
   "bookmarks":[{"name":"DNS","url":"http://192.168.1.50:8081","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
   "want":{"key":"1::http://192.168.1.50:8081","via":"port"}},
  {"name":"a javascript webui is no webui",
   "container":{"name":"odd","webui":"javascript:alert(1)","ports":[]},

   "container":{"name":"radarr","ports":[7878]},
   "bookmarks":[{"name":"Radarr","url":"https://films.example.com","pageId":1},{"name":"Films","url":"http://nas.lan:7878","pageId":1}],
   "links":{},
   "hosts":["nas.lan","nextdash.local"],
